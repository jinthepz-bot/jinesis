# Copy this file to .env and fill in your key, then restart Expo.
# .env is gitignored. Note: EXPO_PUBLIC_* values are bundled into the app,
# so this setup is for running on your own phone during development only.

# Gemini is the default provider - it has a free tier. Get a key at
# https://aistudio.google.com/apikey. Leave empty to run with mock responses.
EXPO_PUBLIC_GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
# EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash

# Optional. Set to "claude" to use the Claude API instead (needs a paid
# Anthropic key below). Anything else, or leaving this unset, uses Gemini.
# EXPO_PUBLIC_LLM_PROVIDER=claude

# Only read when EXPO_PUBLIC_LLM_PROVIDER=claude.
# EXPO_PUBLIC_ANTHROPIC_API_KEY=
# EXPO_PUBLIC_ANTHROPIC_MODEL=claude-opus-5

# Optional. Set to true to use mock responses even when a key is set.
# EXPO_PUBLIC_USE_MOCK=false
